# Copy to .env.local. Never commit real values.
# Client-safe variables start with NEXT_PUBLIC_. Everything else is server-only.

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
# Set true only outside production to show is_demonstration catalog rows.
ALLOW_DEMO_CATALOG=false
MAINTENANCE_MODE=false

# Supabase — public key may be the publishable key or the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Use the new secret key or the service-role key. Never expose it to the browser.
SUPABASE_SECRET_KEY=your-server-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Hostinger's database screen uses these server-only names. They fill in only when the names above are unset.
# SUPABASE_API_KEY is the publishable or anon key, never the service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_API_KEY=your-publishable-or-anon-key

# Payments. test is the default. live is ignored as a successful charge until a provider webhook verifies the amount.
PAYMENT_MODE=test
PAYMENT_TEST_WEBHOOK_SECRET=replace-with-a-long-random-string
# Stripe (server secret, webhook secret, and a publishable key if you enable Stripe.js later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Email. Messages are logged as skipped until both are set and the domain is verified.
RESEND_API_KEY=
EMAIL_FROM=Sea Turtle Apparel <orders@seaturtleapparel.com>

# Scheduled reservation release. Send Authorization: Bearer <secret> to POST /api/cron/reservations
CRON_SECRET=replace-with-a-long-random-string

# Owner bootstrap. Used only by `npm run create-owner`. Do not commit.
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional later integrations. Leave blank until a contract exists.
# TAX_PROVIDER_API_KEY=
# SHIPPING_CARRIER_API_KEY=
# EXCHANGE_RATE_API_KEY=
# ANALYTICS_MEASUREMENT_ID=
# SENTRY_DSN=
